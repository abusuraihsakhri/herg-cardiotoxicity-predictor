{
  "openapi": "3.1.0",
  "info": {
    "title": "Herg Cardiotoxicity Predictor API",
    "description": "Rule-based audit demonstrator; not a validated hERG cardiotoxicity prediction system.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Return operational counters in JSON format",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          },
          "422": {
            "description": "Invalid input or detected prohibited identifier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return deterministic mock supervisory response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and verify current in-process audit ledger (requires X-Audit-Log-Key)",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "Unauthorized access"
          },
          "503": {
            "description": "Audit-log access not configured"
          }
        },
        "parameters": [
          {
            "name": "X-Audit-Log-Key",
            "in": "header",
            "required": false,
            "description": "Key matching AUDIT_LOG_API_KEY when configured.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
